# Phase 1 can run without any external service in explicitly labeled demo mode.
# Set connected only after configuring Supabase and applying the migration.
NEXT_PUBLIC_APP_MODE=demo

# Use your exact origin. HTTPS is required except on localhost/127.0.0.1.
# Set the production Netlify/custom-domain origin in Netlify environment settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fill these in .env.local or Netlify settings. Public keys are safe for browser use;
# database access is enforced by RLS. Never put a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No paid API, AI model, billing or service-role credentials are used in Phase 1.
# Supabase Google OAuth client secrets belong in the Supabase provider dashboard.
